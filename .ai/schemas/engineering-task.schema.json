{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/engineering-task.schema.json",
  "title": "Engineering Task",
  "description": "A machine-readable contract for an autonomous software engineering task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "objective",
    "requirements",
    "acceptance_criteria",
    "constraints",
    "repository",
    "expected_outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9-]+$"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "planning",
        "architecture",
        "implementation",
        "testing",
        "review",
        "security",
        "adversarial",
        "release"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "source_changes",
          "tests",
          "documentation",
          "commit",
          "pull_request",
          "execution_result",
          "evidence_bundle"
        ]
      },
      "minItems": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could"
          ],
          "default": "must"
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[A-Z0-9-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "enum": [
            "automated_test",
            "static_analysis",
            "security_scan",
            "manual_review",
            "agent_review",
            "runtime_check"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "base_branch"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "working_branch": {
          "type": "string"
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/verification-result.schema.json",
  "title": "Verification Result",
  "description": "Independent, machine-readable verification evidence for an engineering task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "commit",
    "checks",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_verified"
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 7
        },
        "branch": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCheck"
      }
    },
    "summary": {
      "type": "string"
    },
    "blocking_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "category",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^CHECK-[A-Z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "build",
            "unit_test",
            "integration_test",
            "e2e_test",
            "type_check",
            "lint",
            "format",
            "security",
            "dependency",
            "contract",
            "performance",
            "custom"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not_run"
          ]
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "output_reference": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "status"
      ],
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_verified"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "reason"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
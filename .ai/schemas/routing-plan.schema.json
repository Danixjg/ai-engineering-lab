{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/routing-plan.schema.json",
  "title": "Project Routing Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "blueprint_digest",
    "status",
    "governance",
    "recursion",
    "model_portfolio",
    "leader_task",
    "stages",
    "conditional_routes",
    "gaps"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.3" },
    "project_id": { "type": "string" },
    "blueprint_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["ready", "needs_human"] },
    "governance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "recursion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_children_per_issue", "max_total_descendants", "max_parallel_tasks"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 1 },
        "max_children_per_issue": { "type": "integer", "minimum": 1 },
        "max_total_descendants": { "type": "integer", "minimum": 1 },
        "max_parallel_tasks": { "type": "integer", "minimum": 1 }
      }
    },
    "model_portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "backend",
        "capacity",
        "models",
        "distinct_model_count",
        "minimum_distinct_models",
        "observed_maximum_model_share",
        "maximum_model_share",
        "stage_diversity"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "required": ["provider", "protocol_family"],
          "properties": {
            "provider": { "type": "string" },
            "protocol_family": { "type": "string" }
          }
        },
        "backend": {
          "type": "object",
          "required": ["provider", "endpoint"],
          "properties": {
            "provider": { "type": "string" },
            "endpoint": { "type": "string" }
          }
        },
        "capacity": {
          "type": "object",
          "required": [
            "profile",
            "maximum_parallel_tasks",
            "maximum_loaded_models",
            "context_tokens",
            "maximum_risk_level",
            "requested_parallel_tasks",
            "effective_parallel_tasks"
          ],
          "properties": {
            "profile": { "type": "string" },
            "maximum_parallel_tasks": { "type": "integer", "minimum": 1 },
            "maximum_loaded_models": { "type": "integer", "minimum": 1 },
            "context_tokens": { "type": "integer", "minimum": 16384 },
            "maximum_risk_level": { "type": "string" },
            "requested_parallel_tasks": { "type": "integer", "minimum": 1 },
            "effective_parallel_tasks": { "type": "integer", "minimum": 1 }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "distinct_model_count": { "type": "integer", "minimum": 1 },
        "minimum_distinct_models": { "type": "integer", "minimum": 2 },
        "observed_maximum_model_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_model_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "stage_diversity": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "leader_task": { "$ref": "#/$defs/task" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "name", "barrier", "tasks"],
        "properties": {
          "stage": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "barrier": { "type": "boolean" },
          "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" }, "minItems": 1 }
        }
      }
    },
    "conditional_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "template_id",
        "title",
        "task_type",
        "role",
        "recursive",
        "agent",
        "selected_skills"
      ],
      "properties": {
        "template_id": { "type": "string" },
        "title": { "type": "string" },
        "task_type": { "type": "string" },
        "role": { "type": "string" },
        "recursive": { "type": "boolean" },
        "agent": { "type": ["object", "null"] },
        "selected_skills": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/agent.schema.json",
  "title": "Engineering Agent",
  "description": "Machine-readable definition of an autonomous software engineering agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "name",
    "role",
    "runtime",
    "responsibilities",
    "forbidden_actions",
    "inputs",
    "outputs",
    "skills",
    "dependencies",
    "authentication",
    "health_checks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.3"
    },

    "agent_id": {
      "type": "string",
      "pattern": "^AGENT-[A-Z0-9-]+$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "role": {
      "type": "string",
      "enum": [
        "planner",
        "architect",
        "builder",
        "tester",
        "reviewer",
        "security",
        "adversarial",
        "judge",
        "release"
      ]
    },

    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "executable",
        "requirements"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum"],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
            }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_mode",
            "capabilities"
          ],
          "properties": {
            "runtime_mode": {
              "type": "string",
              "enum": [
                "local",
                "remote"
              ]
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },

    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "optional"],
      "properties": {
        "system": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },

    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },

    "health_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },

    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engineering_task",
          "execution_result",
          "findings",
          "evidence_bundle",
          "repository",
          "pull_request"
        ]
      }
    },

    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engineering_task",
          "execution_result",
          "finding",
          "evidence_bundle",
          "pull_request"
        ]
      }
    },

    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_read": {
          "type": "boolean",
          "default": true
        },
        "repository_write": {
          "type": "boolean",
          "default": false
        },
        "create_branch": {
          "type": "boolean",
          "default": false
        },
        "create_commit": {
          "type": "boolean",
          "default": false
        },
        "create_pull_request": {
          "type": "boolean",
          "default": false
        },
        "merge_pull_request": {
          "type": "boolean",
          "default": false
        },
        "deploy": {
          "type": "boolean",
          "default": false
        },
        "production_access": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "max_task_duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_files_changed": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/agent.schema.json",
  "title": "Engineering Agent",
  "description": "Machine-readable definition of an autonomous software engineering agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "name",
    "role",
    "runtime",
    "responsibilities",
    "forbidden_actions",
    "inputs",
    "outputs",
    "skills",
    "dependencies",
    "authentication",
    "health_checks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.2"
    },

    "agent_id": {
      "type": "string",
      "pattern": "^AGENT-[A-Z0-9-]+$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "role": {
      "type": "string",
      "enum": [
        "engineering-lead",
        "planner",
        "architect",
        "builder",
        "integrator",
        "tester",
        "reviewer",
        "security",
        "adversarial",
        "judge",
        "release"
      ]
    },

    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "executable"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum"],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
            }
          }
        }
      }
    },

    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "instructions_path": {
      "type": "string",
      "pattern": "^[^/].*\\.md$"
    },

    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "task_types",
        "priority",
        "eligible_risk_levels",
        "max_parallel_tasks"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "task_types": {
          "type": "array",
          "items": {
            "enum": [
              "planning",
              "architecture",
              "implementation",
              "testing",
              "review",
              "security",
              "adversarial",
              "release"
            ]
          },
          "uniqueItems": true
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "eligible_risk_levels": {
          "type": "array",
          "items": { "enum": ["low", "medium", "high", "critical"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },

    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "optional"],
      "properties": {
        "system": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },

    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },

    "health_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },

    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engineering_task",
          "project_blueprint",
          "routing_plan",
          "execution_result",
          "verification_result",
          "repair_request",
          "findings",
          "evidence_bundle",
          "repository",
          "pull_request"
        ]
      }
    },

    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engineering_task",
          "routing_plan",
          "execution_result",
          "verification_result",
          "repair_request",
          "finding",
          "evidence_bundle",
          "pull_request",
          "decision"
        ]
      }
    },

    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_read": {
          "type": "boolean",
          "default": true
        },
        "repository_write": {
          "type": "boolean",
          "default": false
        },
        "create_branch": {
          "type": "boolean",
          "default": false
        },
        "create_commit": {
          "type": "boolean",
          "default": false
        },
        "create_pull_request": {
          "type": "boolean",
          "default": false
        },
        "merge_pull_request": {
          "type": "boolean",
          "default": false
        },
        "deploy": {
          "type": "boolean",
          "default": false
        },
        "production_access": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "max_task_duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_files_changed": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

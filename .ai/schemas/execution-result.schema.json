{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/execution-result.schema.json",
  "title": "Execution Result",
  "description": "Structured output produced by an engineering agent after executing a task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "summary",
    "changes",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "blocked",
        "needs_human"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_changed"
      ],
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_deleted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit_sha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "pull_request": {
          "type": "integer"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "all_passed": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_intervention_required": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "unit_test",
            "integration_test",
            "e2e_test",
            "lint",
            "type_check",
            "build",
            "security_scan",
            "dependency_scan",
            "format_check",
            "custom"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not_run"
          ]
        },
        "command": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
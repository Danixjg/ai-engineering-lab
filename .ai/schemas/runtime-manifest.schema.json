{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/runtime-manifest.schema.json",
  "title": "MultiEngin Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace",
    "compatibility",
    "runtimes",
    "model_backends"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.2" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "configuration"],
      "properties": {
        "source": { "const": "multica_cloud" },
        "configuration": { "const": "local_multica_profile" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python"],
      "properties": {
        "python": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "runtimes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executable", "version_pattern", "installer", "configuration", "launch"],
        "properties": {
          "executable": { "type": "string", "minLength": 1 },
          "version_pattern": { "type": "string", "minLength": 1 },
          "installer": { "enum": ["opencode_cli", "external"] },
          "configuration": { "type": "string", "minLength": 1 },
          "launch": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "model_backends": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executable", "endpoint", "health_check", "server", "installer"],
        "properties": {
          "executable": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "format": "uri" },
          "health_check": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "server": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "installer": { "enum": ["ollama_cli", "external"] }
        }
      }
    }
  }
}

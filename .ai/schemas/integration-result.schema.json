{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-lab.local/schemas/integration-result.schema.json",
  "title": "Integration Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "target_branch", "source_commits", "checks", "summary", "generated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" },
    "status": { "type": "string", "enum": ["integrated", "conflict", "blocked", "merged"] },
    "target_branch": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "minLength": 7 },
    "source_commits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 7 }
    },
    "result_sha": { "type": "string", "minLength": 7 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
          "command": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
